APP_NAME="MenúGO"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://menugo.com.co     # ← dominio real del proyecto

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                   # debug solo en desarrollo

# ── Base de datos central ──────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menugo
DB_USERNAME=menugo_user           # crear usuario dedicado (no root)
DB_PASSWORD=                      # contraseña segura

# ── Sesión ─────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database           # database para persistencia multi-proceso
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true        # true si el sitio usa HTTPS

# ── Caché ──────────────────────────────────────────────────────────────────────
CACHE_STORE=database              # database o redis en producción

# ── Queue ──────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Redis (opcional — reemplaza database para cache/session en producción) ─────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@menugo.com.co
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@menugo.com.co"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS Storage (opcional — para imágenes en S3) ───────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── MenúGO — Variables específicas del proyecto ────────────────────────────────

# Ruta secreta del panel SuperAdmin (no usar /admin)
ADMIN_LOGIN_PATH=sistema/acceso-control

# WhatsApp de soporte (sin + ni espacios, con código de país)
SUPPORT_WHATSAPP=573172623919

# Tenancy — prefijo para las BDs de cada restaurante
TENANCY_DB_PREFIX=menugo_

# ── Vite ───────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
